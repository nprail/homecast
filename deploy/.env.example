# Used by docker-compose.caddy.yml (required there, ignored by docker-compose.yml):
DOMAIN=podcasts.example.com

# Optional, for either file:
# HOMECAST_TAG=latest      # or main, or a version such as 1.2.0
# PUBLIC_URL=http://192.168.1.10:8080   # default for docker-compose.yml is http://localhost:8080
