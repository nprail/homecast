{
  "name": "@homecast/docstore",
  "version": "1.0.0",
  "description": "A small in-memory document store with indexes and a crash-safe journal. Pure JavaScript, no dependencies.",
  "license": "MIT",
  "author": "Noah Prail",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.2"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "bench": "tsx bench/vs-loki.ts",
    "docs:dev": "docmd dev",
    "docs:build": "docmd build"
  },
  "devDependencies": {
    "@types/lokijs": "1.5.14",
    "lokijs": "1.5.12",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "@docmd/core": "0.9.9"
  }
}
